{
  "base_model": "openai-community/gpt2",
  "dataset": "data/validated/financial_dataset_v1.json",
  "split_dir": "data/processed",
  "tokenized_dir": "data/processed/tokenized",
  "max_length": 160,
  "seed": 42,
  "full_finetuning": {
    "epochs": 3,
    "batch_size": 1,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "gradient_clip_norm": 1.0,
    "gradient_checkpointing": true,
    "mixed_precision": "fp16"
  },
  "lora": {
    "rank": 4,
    "alpha": 8,
    "dropout": 0.05,
    "target_modules": ["c_attn"],
    "epochs": 3,
    "batch_size": 1,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "gradient_clip_norm": 1.0,
    "gradient_checkpointing": true,
    "mixed_precision": "fp16"
  },
  "generation": {
    "do_sample": false,
    "max_new_tokens": 100,
    "repetition_penalty": 1.1,
    "no_repeat_ngram_size": 3,
    "temperature": 1.0,
    "top_k": 0,
    "top_p": 1.0
  }
}
